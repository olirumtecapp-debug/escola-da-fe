                                ${visibleEvents.length > 0 ? 'cursor-pointer hover:shadow-md hover:z-10' : ''}
                                ${isToday ? 'ring-2 ring-catholic-wine ring-inset' : ''}
                                rounded-lg sm:rounded-none mb-2 sm:mb-0
                            `}
