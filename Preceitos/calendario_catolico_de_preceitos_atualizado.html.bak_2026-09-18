                        <div className="bg-white px-6 py-4 border-b border-gray-100 overflow-x-auto no-print">
                            <div className="flex gap-2 min-w-max">
                                <button onClick={() => setFilter('all')} className={`px-4 py-1.5 rounded-full text-xs font-semibold transition-all ${filter === 'all' ? 'bg-gray-800 text-white shadow-sm' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>Todos</button>
