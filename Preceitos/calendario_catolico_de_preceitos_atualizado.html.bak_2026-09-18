                                    <span className="px-3 text-sm font-medium w-24 text-center">{MONTHS[currentMonth].substring(0,3)} {currentYear}</span>
                                    <button onClick={nextMonth} disabled={currentYear === 2030 && currentMonth === 11} className="p-2 text-gray-600 hover:text-catholic-wine disabled:opacity-30 rounded-lg"><i className="ph-bold ph-caret-right"></i></button>
                                </div>
                            </div>
                        </div>

