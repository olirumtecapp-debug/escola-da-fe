        const Calendar = ({ year }) => {
            const [currentMonth, setCurrentMonth] = React.useState(new Date().getMonth());
            const [currentYear, setCurrentYear] = React.useState(year);
            const [filter, setFilter] = React.useState('all');
            const [selectedDateEvents, setSelectedDateEvents] = React.useState(null);

            // Sync year if prop changes from Hero
            React.useEffect(() => {
                if(year >= 2026 && year <= 2030) {
                    setCurrentYear(year);
                }
            }, [year]);

            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();

            const nextMonth = () => {
                if (currentMonth === 11) {
                    if (currentYear < 2030) { setCurrentMonth(0); setCurrentYear(currentYear + 1); }
                } else { setCurrentMonth(currentMonth + 1); }
            };

            const prevMonth = () => {
                if (currentMonth === 0) {
                    if (currentYear > 2026) { setCurrentMonth(11); setCurrentYear(currentYear - 1); }
                } else { setCurrentMonth(currentMonth - 1); }
            };

            const goToToday = () => {
                const today = new Date();
                if(today.getFullYear() >= 2026 && today.getFullYear() <= 2030) {
                    setCurrentYear(today.getFullYear());
                    setCurrentMonth(today.getMonth());
                } else {
                    // Fallback to beginning of 2026 if today is outside range
                    setCurrentYear(2026);
                    setCurrentMonth(0);
                }
            };

            const findNextPreceito = () => {
                let startD = new Date();
                if(startD.getFullYear() < 2026) startD = new Date(2026, 0, 1);
                if(startD.getFullYear() > 2030) return; // out of bounds

                let current = startD;
                while(current.getFullYear() <= 2030) {
                    current.setDate(current.getDate() + 1);
                    const events = getEventsForDay(current.getFullYear(), current.getMonth(), current.getDate());
                    if(events.some(e => e.type === 'preceito' || e.type === 'domingo')) {
                        setCurrentYear(current.getFullYear());
                        setCurrentMonth(current.getMonth());
                        setSelectedDateEvents({
                            date: { year: current.getFullYear(), month: current.getMonth(), day: current.getDate() },
                            events: events
                        });
                        break;
                    }
                }
            };

            // Generate Calendar Grid
            const renderGrid = () => {
                let grid = [];
                // Empty cells before start of month
                for (let i = 0; i < firstDayOfMonth; i++) {
                    grid.push(<div key={`empty-${i}`} className="p-2 sm:p-4 min-h-[100px] bg-gray-50/50 border border-gray-100 hidden sm:block"></div>);
                }

                // Days
                for (let day = 1; day <= daysInMonth; day++) {
                    const events = getEventsForDay(currentYear, currentMonth, day);
                    
                    // Filtering
                    const visibleEvents = filter === 'all' ? events : events.filter(e => e.type === filter || (filter === 'preceito' && e.type === 'domingo'));
                    
                    const isToday = new Date().toDateString() === new Date(currentYear, currentMonth, day).toDateString();
                    
                    // Determine dominant color for border (Preceito > Jejum > Solenidade > Penitencia)
                    let borderClass = 'border-gray-100';
                    let bgClass = 'bg-white';
                    
                    if (visibleEvents.length > 0) {
                        if (visibleEvents.some(e => e.type === 'preceito')) { borderClass = 'border-catholic-red'; bgClass = 'bg-red-50/30'; }
                        else if (visibleEvents.some(e => e.type === 'domingo')) { borderClass = 'border-catholic-wine'; bgClass = 'bg-pink-50/30'; }
                        else if (visibleEvents.some(e => e.type === 'jejum')) { borderClass = 'border-catholic-purple'; bgClass = 'bg-purple-50/30'; }
                        else if (visibleEvents.some(e => e.type === 'solenidade')) { borderClass = 'border-catholic-gold'; bgClass = 'bg-yellow-50/30'; }
                        else if (visibleEvents.some(e => e.type === 'penitencia')) { borderClass = 'border-catholic-blue/30'; bgClass = 'bg-blue-50/20'; }
                    }

                    grid.push(
                        <div 
                            key={`day-${day}`} 
                            onClick={() => visibleEvents.length > 0 && setSelectedDateEvents({date: {year: currentYear, month: currentMonth, day}, events: visibleEvents})}
