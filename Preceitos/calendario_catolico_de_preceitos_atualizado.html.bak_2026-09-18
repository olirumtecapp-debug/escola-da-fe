            const dateStr = formatDateString(year, month, day);
            const dateObj = new Date(year, month, day);
            const dayOfWeek = dateObj.getDay();
            
            let events = [];

            // 1. Check database for specific events
            const specificEvents = PRECEITOS_DATA.filter(e => e.date === dateStr);
            if (specificEvents.length > 0) {
                events.push(...specificEvents);
            }

            // 2. Logic for Sundays
            if (dayOfWeek === 0) {
                // Check if there isn't already a specific 'preceito' rule for this Sunday
                const hasSpecificPreceito = events.some(e => e.type === 'preceito');
                if (!hasSpecificPreceito) {
                    events.push({
                        date: dateStr,
                        name: 'Domingo',
                        type: 'domingo',
                        desc: 'Dia semanal de preceito. A obrigação pode ser satisfeita no sábado à tarde/noite.',
                        canon: 'Cân. 1246 §1, 1247, 1248'
                    });
                }
            }

            // 3. Logic for Fridays (Penitence)
            if (dayOfWeek === 5) {
                // Exceptions: If it's Good Friday (jejum), or a Solemnity (like St. Joseph or Christmas if it falls on Friday)
                const hasException = events.some(e => e.type === 'solenidade' || e.type === 'jejum' || (e.type === 'preceito' && e.name === 'Natal do Senhor'));
                
