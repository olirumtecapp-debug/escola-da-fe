                            <div className="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                                <button onClick={goToToday} className="px-4 py-2 text-sm font-medium text-gray-600 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors">Hoje</button>
                                <button onClick={findNextPreceito} className="px-4 py-2 text-sm font-medium text-white bg-catholic-wine rounded-xl shadow-sm hover:bg-catholic-wine/90 transition-colors flex items-center gap-2">
                                    <i className="ph ph-calendar-check"></i> Próximo Preceito
